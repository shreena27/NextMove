# Documents the env(...) indirections referenced from supabase/config.toml.
# None of these are set in local development on purpose — see the comments
# at each config.toml site for why. This file exists so "unresolved" reads
# as "deliberate", not "someone forgot to create supabase/.env".
#
# To actually use any of these (a real deployed environment, or exercising
# a real provider locally), copy this file to supabase/.env (gitignored)
# and fill in real values. Never commit supabase/.env.

# Google OAuth ("Continue with Google") — Task 18's job to fill in, once a
# Google Cloud OAuth client exists. Deliberately unset through Tasks 1-17;
# GoTrue starts healthy regardless (verified) and a real sign-in attempt
# before Task 18 fails on Google's own server, never inside this app.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Twilio — a LOCAL-DEV-ONLY SHIM (see supabase/config.toml's own comment at
# [auth.sms.twilio]). Left permanently unresolved in local development: it
# exists only to satisfy the Supabase CLI's provider-enabled check so phone
# sign-in works at all locally, backed entirely by [auth.sms.test_otp]'s
# fixture numbers, never a real Twilio account. Filling these in would only
# matter for a real deployed environment, and even then a real SMS provider
# for India needs its own separate setup (Twilio DLT registration, or an
# India-focused alternative like Textlocal) — out of this chunk's scope.
SUPABASE_AUTH_SMS_TWILIO_ACCOUNT_SID=
SUPABASE_AUTH_SMS_TWILIO_MESSAGE_SERVICE_SID=
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=
